# Rendered by the nginx image's entrypoint (envsubst only replaces variables set in the environment).
server {
    listen 8080;
    root /usr/share/nginx/html;

    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    # The panel and the admin API share an origin, so there is no CORS to configure. When the
    # ingress routes /admin straight to the gateway this block is simply not used.
    location /admin/ {
        set $gateway ${GATEWAY_UPSTREAM};
        proxy_pass $gateway;
        proxy_set_header Host $host;
        proxy_read_timeout 30s;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Hashed build output never changes under the same name.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Single-page app: unknown paths serve the shell, and the shell itself is never cached.
    location / {
        add_header Cache-Control "no-store";
        try_files $uri /index.html;
    }
}
