# Copy to .env (gitignored) and fill in. Never commit real keys.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Enables /admin and the control panel. `make init` generates one if this is empty.
ADMIN_TOKEN=
POSTGRES_PASSWORD=freeloader
# Host port for the gateway (change if 8080 is already in use on your machine)
GATEWAY_PORT=8080
# Host port for the control panel
PANEL_PORT=3001
